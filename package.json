{
  "name": "hagovnews",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "types": "wrangler types",
    "db:local": "wrangler d1 execute hagovnews-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute hagovnews-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  }
}
